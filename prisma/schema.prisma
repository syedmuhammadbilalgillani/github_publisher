// Prisma schema for GitHub ZIP Publisher
// Datasource is PostgreSQL. Set DATABASE_URL in your environment.
// Run: npx prisma migrate dev  (or)  npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) standard models + app-specific fields
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // GitHub identity
  githubId       String? @unique
  githubUsername String?

  // Encrypted GitHub OAuth access token (AES-256-GCM). Never store plaintext.
  githubAccessToken String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  repositories Repository[]
  uploads      Upload[]
  publishJobs  PublishJob[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// App models
// ---------------------------------------------------------------------------

model Repository {
  id           String  @id @default(cuid())
  githubRepoId String?
  name         String
  fullName     String?
  visibility   String? // "public" | "private"
  defaultBranch String? @default("main")
  htmlUrl      String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  publishJobs PublishJob[]

  createdAt DateTime @default(now())

  @@index([ownerId])
}

enum UploadStatus {
  PENDING
  VALIDATED
  REJECTED
}

model Upload {
  id         String       @id @default(cuid())
  userId     String
  zipName    String
  sizeBytes  Int          @default(0)
  fileCount  Int          @default(0)
  status     UploadStatus @default(PENDING)
  // JSON-serialized file tree preview (string to stay DB-portable)
  fileTree   String?      @db.Text

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  publishJobs PublishJob[]

  createdAt DateTime @default(now())

  @@index([userId])
}

enum PublishStatus {
  QUEUED
  UPLOADING
  EXTRACTING
  READING
  CREATING_REPO
  COMMITTING
  PUSHING
  COMPLETED
  FAILED
}

model PublishJob {
  id           String        @id @default(cuid())
  userId       String
  uploadId     String
  repositoryId String?

  projectName  String
  branch       String        @default("main")
  commitMessage String       @default("Initial project upload")

  status       PublishStatus @default(QUEUED)
  commitHash   String?
  repoUrl      String?
  // Append-only newline-delimited log lines
  logs         String?       @db.Text
  error        String?       @db.Text

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  upload     Upload      @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
